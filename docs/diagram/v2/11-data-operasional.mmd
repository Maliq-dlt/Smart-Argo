title: "RANCANGAN: data operasional"
config:
  htmlLabels: false
  theme: base
  themeVariables:
    fontFamily: Arial
    fontSize: 15px
    primaryColor: "#F3F8F4"
    primaryTextColor: "#111827"
    primaryBorderColor: "#527C63"
    lineColor: "#52665D"
    secondaryColor: "#eff6ff"
    tertiaryColor: "#ffffff"
  themeCSS: '.edgeLabel .label rect.background { fill: #ffffff; } .edgeLabel .label text { fill: #111827; }'
  flowchart:
    htmlLabels: false
