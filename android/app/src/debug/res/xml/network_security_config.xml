<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain http to the emulator's alias for the laptop (local backend on 10.0.2.2:54321).
     Release builds have no network security config and keep usesCleartextTraffic="false". -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
