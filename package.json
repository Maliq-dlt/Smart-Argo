{
  "name": "smart-agro-simulator",
  "private": true,
  "version": "1.11.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:cloud": "tsc --noEmit && vite build --mode cloud",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "backend:local": "node scripts/phase1-local.mjs",
    "test:backend": "node --test --test-concurrency=1 tests/account-activation.integration.mjs tests/telemetry.integration.mjs tests/curation.integration.mjs tests/explanations.integration.mjs tests/energy.integration.mjs tests/reward.integration.mjs tests/ai-explanation.integration.mjs tests/transfer.integration.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "barcode-detector": "3.2.3",
    "framer-motion": "^12.23.0",
    "gsap": "^3.15.1",
    "lenis": "1.3.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.4.0"
  }
}
